<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <handlers>
            <add name="FAST_CGI_PAZIRESH" path="*" verb="*" modules="FastCgiModule" scriptProcessor="C:\repositroy\venvs\prod-paziresh\Scripts\python.exe|C:\repositroy\venvs\prod-paziresh\Lib\site-packages\wfastcgi.py" resourceType="Unspecified" />
        </handlers>
    </system.webServer>
    <appSettings>
        <add key="DJANGO_SETTINGS_MODULE" value="ensaniapp.settings" />
        <add key="PYTHONPATH" value="C:\inetpub\wwwroot\paziresh-v.2.3.0" />
        <add key="WSGI_HANDLER" value="ensaniapp.wsgi.application" />
    </appSettings>
</configuration>
